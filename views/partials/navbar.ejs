<!-- Top Navbar -->
<nav class="navbar navbar-expand-lg navbar-light bg-light px-4 shadow-sm">
  <div class="container-fluid">
    <!-- Brand / Dashboard Title -->
    <span class="navbar-brand fw-bold">Dashboard</span>

    <!-- Collapse toggle for small screens -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNavbarContent">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="topNavbarContent">
      <ul class="navbar-nav ms-auto align-items-center">

        <!-- Notifications Dropdown -->
        <li class="nav-item dropdown me-3">
          <a class="nav-link dropdown-toggle position-relative" href="#" role="button" data-bs-toggle="dropdown">
            <i class="bi bi-bell fs-5"></i>
            <% let totalAlerts=lowStockAlerts.length + expiryAlerts.length; %>
              <% if(totalAlerts> 0){ %>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                  <%= totalAlerts %>
                </span>
                <% } %>
          </a>
          <ul class="dropdown-menu dropdown-menu-end p-2" style="min-width: 250px;">
            <li class="dropdown-header">Notifications</li>
            <% if (totalAlerts===0) { %>
              <li class="dropdown-item text-muted">
                ✅ No alerts at the moment
              </li>
              <% } else { %>

                <% if (lowStockAlerts.length> 0) { %>
                  <li>
                    <hr class="dropdown-divider">
                  </li>
                  <li class="dropdown-header text-danger">Low Stock Alerts</li>
                  <% lowStockAlerts.forEach(item=> { %>
                    <li class="dropdown-item text-danger">
                      ⚠️ <strong>
                        <%= item.name %>
                      </strong> — only <%= item.quantity %> left
                    </li>
                    <% }) %>
                      <% } %>

                        <% if (expiryAlerts.length> 0) { %>
                          <li>
                            <hr class="dropdown-divider">
                          </li>
                          <li class="dropdown-header text-warning">Expiry Alerts</li>
                          <% expiryAlerts.forEach(item=> { %>
                            <li class="dropdown-item text-warning">
                              ⏰ <strong>
                                <%= item.name %>
                              </strong>
                              <% if (item.expiry_date) { %>
                                — expires on <%= new Date(item.expiry_date).toISOString().split('T')[0] %>
                                  <% } else { %>
                                    — expiry date not set
                                    <% } %>
                            </li>
                            <% }) %>
                              <% } %>

                                <% } %>
          </ul>
        </li>

        <!-- User Profile Dropdown -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button"
            data-bs-toggle="dropdown">
            <i class="bi bi-person-circle me-1 fs-5"></i>
            <span>
              <%= req.session.user.name %>
            </span>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="/dashboard/profile"><i class="bi bi-person me-2"></i> Profile</a></li>
            <li><a class="dropdown-item" href="/dashboard/settings"><i class="bi bi-gear me-2"></i> Settings</a></li>
            <li>
              <hr class="dropdown-divider">
            </li>
            <li><a class="dropdown-item text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>
                Logout</a></li>
          </ul>
        </li>

      </ul>
    </div>
  </div>
</nav>