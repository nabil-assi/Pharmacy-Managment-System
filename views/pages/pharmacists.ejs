<!-- Main Content -->
<div class="main-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4>Pharmacist List</h4>
        <button class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Add Pharmacist</button>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% for( let i=0; i < pharmacists.length; i++ ) { %>

                    <tr>
                        <td><%= i+1 %></td>
                        <td><%= pharmacists[i].name %></td>
                        <td><%= pharmacists[i].email %></td>
                        <td><%= pharmacists[i].role %></td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary me-1" onclick="editPharmacist(1)">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" onclick="deletePharmacist(1)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>

                    </tr>
                    <% } %>


            </tbody>
        </table>
    </div>
</div>