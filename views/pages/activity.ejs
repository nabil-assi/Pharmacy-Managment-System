<div class="container mt-4">
    <h2 class="mb-4">Activity Logs</h2>

    <% if (logs.length===0) { %>
        <div class="alert alert-secondary">No activity recorded yet.</div>
        <% } else { %>
            <!-- Responsive wrappers for all screen sizes -->
            <div
                class="table-responsive table-responsive-sm table-responsive-md table-responsive-lg table-responsive-xl table-responsive-xxl">
                <table class="table table-sm table-bordered align-middle" style="font-size: 0.85rem;">
                    <thead style="background-color: #f8f9fa; color: #000;">
                        <tr>
                            <th>#</th>
                            <th>User ID</th>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>Entity ID</th>
                            <th>Description</th>
                            <th>Timestamp</th>
                            <th>Since</th>
                            <th>IP Address</th>
                            <th>User Agent</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% logs.forEach((log, index)=> { %>
                            <tr style="background-color: #fff; color: #000;">
                                <td>
                                    <%= index + 1 %>
                                </td>
                                <td>
                                    <%= log.user_id || 'Data Not Available' %>
                                </td>
                                <td>
                                    <%= log.action_type || 'Data Not Available' %>
                                </td>
                                <td>
                                    <%= log.entity_type || 'Data Not Available' %>
                                </td>
                                <td>
                                    <%= log.entity_id || 'Data Not Available' %>
                                </td>
                                <td>
                                    <%= log.description || 'Data Not Available' %>
                                </td>
                                <td>
                                    <%= new Date(log.timestamp).toLocaleString() || 'Data Not Available' %>
                                </td>
                                <td>
                                    <%= log.timeAgo || 'Data Not Available' %>
                                </td>
                                <td>
                                    <%= log.ip_address || 'Data Not Available' %>
                                </td>
                                <td title="<%= log.user_agent %>">
                                    <%= log.user_agent ? log.user_agent.slice(0, 40) + '...' : 'Data Not Available' %>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
            <% } %>
</div>