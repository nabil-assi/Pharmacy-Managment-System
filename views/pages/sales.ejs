<div class="main-content">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold text-dark">Sales Records</h4>
    <button class="btn btn-pharma d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#addSaleModal">
      <i class="bi bi-plus-circle me-1"></i> Add Sale
    </button>
  </div>

  <div class="table-responsive shadow-sm rounded bg-white p-3">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-success text-dark">
        <tr>
          <th>Date</th>
          <th>Customer</th>
          <th>Medicines</th>
          <th>Quantity</th>
          <th>Total Amount</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% for(let i=0; i<sales.length; i++) { %>
        <tr>
          <td><%= sales[i].sale_date_formatted %></td>
          <td>
            <a href="/dashboard/customers/<%= sales[i].customer_id %>" class="text-success text-decoration-none">
              <%= sales[i].customer_name %>
            </a>
          </td>
          <td><%= sales[i].medicine_name %></td>
          <td><%= sales[i].quantity %></td>
          <td>$<%= parseFloat(sales[i].total_price).toFixed(2) %></td>
          <td>
            <a href="/dashboard/sales/print/<%= sales[i].id %>" target="_blank" class="btn btn-sm btn-outline-info me-1" title="Print Report">
              <i class="bi bi-printer"></i>
            </a>
            <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal<%= sales[i].id %>" title="Delete Sale">
              <i class="bi bi-trash"></i>
            </button>
          </td>
        </tr>

        <!-- Delete Modal -->
        <div class="modal fade" id="deleteModal<%= sales[i].id %>" tabindex="-1" aria-labelledby="deleteLabel<%= sales[i].id %>" aria-hidden="true">
          <div class="modal-dialog">
            <div class="modal-content">
              <form action="/dashboard/sales/delete/<%= sales[i].id %>" method="POST">
                <div class="modal-header bg-danger text-white">
                  <h5 class="modal-title" id="deleteLabel<%= sales[i].id %>">Confirm Deletion</h5>
                  <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                  <p>Are you sure you want to delete this sale for <strong><%= sales[i].customer_name %></strong>?</p>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                  <button type="submit" class="btn btn-danger">Delete</button>
                </div>
              </form>
            </div>
          </div>
        </div>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Add Sale Modal -->
  <div class="modal fade" id="addSaleModal" tabindex="-1" aria-labelledby="addSaleLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <form action="/dashboard/sales/add" method="POST">
          <div class="modal-header bg-primary text-white">
            <h5 class="modal-title" id="addSaleLabel">Add New Sale</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <fieldset class="mb-4 p-3 border rounded">
              <legend class="float-none w-auto px-2 fs-6">
                Select Customer
                <a href="/dashboard/customers/add" class="ms-3 badge text-bg-success text-decoration-none">
                  <i class="bi bi-person-plus me-1"></i> Create New
                </a>
              </legend>
              <div id="existingCustomerFields" class="mt-2">
                <select name="customer_id" class="form-select" required>
                  <option value="" disabled selected>Choose Existing Customer...</option>
                  <% customers?.forEach(customer => { %>
                    <option value="<%= customer.id %>"><%= customer.name %></option>
                  <% }) %>
                </select>
              </div>
            </fieldset>

            <fieldset class="p-3 border rounded">
              <legend class="float-none w-auto px-2 fs-6">Medicine Details</legend>
              <div class="row g-3">
                <div class="col-md-8">
                  <select name="medicine_id" class="form-select" required>
                    <option value="" disabled selected>Choose Medicine...</option>
                    <% medicines?.forEach(med => { %>
                      <option value="<%= med.id %>"><%= med.name %> (Stock: <%= med.quantity %>)</option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-md-4">
                  <input type="number" name="quantity" class="form-control" placeholder="Quantity" min="1" required>
                </div>
              </div>
            </fieldset>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-pharma">Complete Sale</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<style>
  .table-responsive {
    background: #fff;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.05);
  }

  .table-hover tbody tr:hover {
    background-color: #e6f4ea;
    transition: 0.2s;
  }

  .table-success {
    background: linear-gradient(90deg, #d1fae5, #a7f3d0);
  }

  .btn-pharma {
    background: linear-gradient(135deg, #16a34a, #22c55e);
    color: #fff;
    font-weight: 600;
    border: none;
    transition: 0.3s;
  }

  .btn-pharma:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(34,197,94,0.4);
  }

  .modal-header.bg-primary {
    background: linear-gradient(135deg, #3b82f6, #06b6d4);
  }

  .modal-header.bg-danger {
    background: linear-gradient(135deg, #dc2626, #f87171);
  }
</style>
