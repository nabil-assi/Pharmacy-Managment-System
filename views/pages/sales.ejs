<!-- Main Content -->
<div class="main-content">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4>Sales Records</h4>
    <button class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Add Sale</button>
  </div>

  <div class="table-responsive">
    <table class="table table-bordered table-striped">
      <thead class="table-light">
        <tr>
          <th>Date</th>
          <th>Customer</th>
          <th>Medicines</th>
          <th>Quantity</th>
          <th>Total Amount</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% for( let i=0; i < sales.length; i++ ) { %>

          <tr>
            <td><%= sales[i].sale_date_formatted %></td>
            <td> <a href="/dashboard/customers/<%= sales[i].customer_id %>">
              <%= sales[i].customer_name %>
            </a> </td>
            <td><%= sales[i].medicine_name %></td>
            <td><%= sales[i].quantity %></td>
            <td>$<%= sales[i].total_price %></td>
            <td>
              <button class="btn btn-sm btn-outline-primary me-1" onclick="editSale(1)">
                <i class="bi bi-pencil-square"></i>
              </button>
              <button class="btn btn-sm btn-outline-danger" onclick="deleteSale(1)">
                <i class="bi bi-trash"></i>
              </button>
            </td>
          </tr>
          <% } %>


      </tbody>
    </table>
  </div>
</div>