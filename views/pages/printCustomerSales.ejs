<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Sale Report</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Segoe UI', 'Roboto', sans-serif;
            background: #f4f5f7;
            color: #212529;
            padding: 3rem;
        }

        .report-container {
            background: #fff;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            padding: 2.5rem;
            max-width: 900px;
            margin: auto;
        }

        .report-header {
            border-bottom: 2px solid #0d6efd;
            padding-bottom: 1rem;
            margin-bottom: 2rem;
        }

        .report-header h2 {
            font-size: 1.75rem;
            font-weight: 600;
            margin: 0;
            color: #0d6efd;
        }

        .company-info {
            font-size: 0.9rem;
            color: #6c757d;
            line-height: 1.4;
        }

        .table {
            margin-top: 1rem;
        }

        .table th {
            background: #f8f9fa;
            width: 35%;
            font-weight: 600;
            vertical-align: middle;
        }

        .table td {
            background: #fff;
        }

        .section-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: #0d6efd;
            margin-top: 2rem;
            margin-bottom: 0.75rem;
            border-bottom: 1px solid #dee2e6;
            padding-bottom: 0.3rem;
        }

        .print-btn {
            float: right;
            margin-top: -3rem;
            margin-right: 0.25rem;
        }

        .footer-text {
            text-align: right;
            color: #6c757d;
            font-size: 0.9rem;
            margin-top: 2rem;
            border-top: 1px solid #dee2e6;
            padding-top: 0.5rem;
        }

        .signature-section {
            margin-top: 3rem;
            display: flex;
            justify-content: space-between;
        }

        .signature-box {
            width: 45%;
            text-align: center;
            border-top: 1px solid #000;
            padding-top: 0.5rem;
            font-size: 0.9rem;
            color: #495057;
        }

        @media print {
            body {
                background: #fff;
                padding: 0;
            }

            .report-container {
                border: none;
                box-shadow: none;
                margin: 0;
                padding: 0;
            }

            .print-btn {
                display: none;
            }

            @page {
                size: A4;
                margin: 20mm;
            }
        }
    </style>
</head>

<body>

    <div class="report-container">
        <button class="btn btn-outline-secondary print-btn" onclick="window.print()">🖨️ Print</button>

        <!-- Header -->
        <div class="report-header d-flex justify-content-between align-items-center">
            <div>
                <h2>Sale Report</h2>
                <div class="company-info">
                    <%= pharmacy.pharmacy_name %><br>
                        <%= pharmacy.address %><br>
                            Phone: <%= pharmacy.phone_number%><br>
                                Email: <%= pharmacy.email %>
                </div>
            </div>
             
        </div>

        <!-- Sale Information -->
        <div class="section-title">Sale Information</div>
        <table class="table table-bordered">
            <tbody>
                <tr>
                    <th>Sale ID</th>
                    <td>
                        <%= sale.id %>
                    </td>
                </tr>
                <tr>
                    <th>Date</th>
                    <td>
                        <%= sale.sale_date %>
                    </td>
                </tr>
                <tr>
                    <th>Medicine</th>
                    <td>
                        <%= medicine.name %>
                    </td>
                </tr>
                <tr>
                    <th>Quantity</th>
                    <td>
                        <%= sale.quantity %>
                    </td>
                </tr>
                <tr>
                    <th>Total Price</th>
                    <td>$<%= sale.total_price %>
                    </td>
                </tr>
                <tr>
                    <th>Payment Method</th>
                    <td> - </td>
                </tr>
                <tr>
                    <th>Handled By</th>
                    <td>
                        <%= sale.handled_by %>
                    </td>
                </tr>
                <tr>
                    <th>Payment Status</th>
                    <td> - </td>
                </tr>
            </tbody>
        </table>

        <!-- Customer Information -->
        <div class="section-title">Customer Information</div>
        <table class="table table-bordered">
            <tbody>
                <tr>
                    <th>Customer Name</th>
                    <td>
                        <%= customer.name %>
                    </td>
                </tr>
                <tr>
                    <th>Phone</th>
                    <td>
                        <%= customer.phone %>
                    </td>
                </tr>
                <tr>
                    <th>Email</th>
                    <td>
                        <%= customer.email %>
                    </td>
                </tr>
                <tr>
                    <th>Address</th>
                    <td>
                        <%= customer.address %>
                    </td>
                </tr>
            </tbody>
        </table>

       
        <!-- Footer -->
        <p class="footer-text">
            Printed on: <%= new Date().toLocaleDateString() %>
        </p>
    </div>

</body>

</html>