<!-- Main Content -->
<div class="main-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4>Medicine Batches</h4>
        <button class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Add Batch</button>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                  <th>#</th>
      <th>Code</th>
      <th>Supplier</th>
      <th>Received Date</th>

                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>

                <% for( let i=0; i < batches.length; i++ ) { %>


                    <tr>
                        <td>
                            <%= i + 1 %>
                        </td>
                        <td>
                            <%= batches[i].code %>
                        </td>
                        <td>
                            <%= batches[i].supplier %>
                        </td> <!-- اسم المورد مباشرة -->
                        <td>
                            <%= batches[i].received_date_formatted %>
                        </td>

                        <td>
                            <button class="btn btn-sm btn-outline-primary me-1" onclick="editBatch(1)">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteBatch(1)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                    <% } %>
            </tbody>
        </table>
    </div>
</div>