<!-- Main Content -->
<div class="main-content">
  <div class="section-card">
    <div class="section-title"><i class="bi bi-building me-2"></i> Pharmacy Information</div>
    <form>
      <div class="mb-3">
        <label class="form-label">Pharmacy Name</label>

          <input type="text" class="form-control" value="<%= pharmacy.pharmacy_name %>">

      </div>
      <div class="mb-3">
        <label class="form-label">Address</label>
        <input type="text" class="form-control" value="<%= pharmacy.address %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Phone Number</label>
        <input type="text" class="form-control" value="<%= pharmacy.phone_number %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" class="form-control" value="<%= pharmacy.address %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Working Hours</label>
        <input type="text" class="form-control" value="<%= pharmacy.working_hours %>">
      </div>
      <button class="btn btn-primary">Save Changes</button>
    </form>
  </div>
</div>