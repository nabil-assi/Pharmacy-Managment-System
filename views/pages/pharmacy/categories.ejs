<section class="py-5 bg-light">
  <div class="container">
    <!-- Section Title -->
    <div class="text-center mb-5">
      <h2 class="fw-bold text-primary mb-2">Product Categories</h2>
      <p class="text-muted">Browse our wide range of trusted health and wellness categories</p>
    </div>

    <!-- Categories Grid -->
    <div class="row g-4">
      <section class="py-5 bg-light">
        <div class="container">
          <h2 class="fw-bold text-primary mb-4">Product Categories</h2>
          <div class="row g-4">
            <% if (categories && categories.length> 0) { %>
              <% categories.forEach(category=> { %>
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                  <div class="card border-0 shadow-sm category-card h-100 text-center transition">
                    <div class="card-body d-flex flex-column py-4">

                       <div class="fs-1 text-primary mb-3">
                        <% if(category.icon){ %>
                          <img src="<%= category.icon %>" alt="<%= category.name %>" style="width:50px; height:50px;">
                          <% } else { %>
                            💊
                            <% } %>
                      </div>

                       <h5 class="card-title fw-semibold mb-2">
                        <%= category.name %>
                      </h5>

                       <p class="card-text text-muted small mb-3">
                        <%= category.description ? category.description.substring(0, 80)
                          : 'Explore our products in this category.' %>
                      </p>

                       <a href="/home/category/<%= category.id %>"
                        class="btn btn-outline-primary rounded-pill mt-auto px-4">
                        View Products
                      </a>
                    </div>
                  </div>
                </div>
                <% }) %>
                  <% } else { %>
                    <p class="text-muted">No categories available.</p>
                    <% } %>


          </div>
        </div>
      </section>







    </div>
  </div>
</section>

<!-- Bootstrap Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<!-- Custom Styles -->
<style>
  .category-card {
    border-radius: 1rem;
    transition: all 0.3s ease;
    background-color: #fff;
  }

  .category-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 1rem 1.5rem rgba(0, 0, 0, 0.1);
  }

  .category-card .fs-1 {
    font-size: 2.5rem;
  }

  .category-card .btn {
    font-size: 0.9rem;
  }
</style>