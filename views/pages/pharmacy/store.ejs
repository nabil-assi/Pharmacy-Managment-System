<section class="py-5 bg-light">
  <div class="container">

    <!-- Header + Filter -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-center mb-5">
      <h2 class="fw-bold text-primary mb-3 mb-lg-0">Our Products</h2>
      <form class="d-flex" action="/medicines" method="GET" style="max-width: 400px;">
        <input class="form-control me-2 rounded-pill" type="search" name="q" placeholder="Search for a medicine..." aria-label="Search">
        <button class="btn btn-primary rounded-pill px-4" type="submit">
          <i class="bi bi-search"></i>
        </button>
      </form>
    </div>

    <!-- Product Grid -->
    <div class="row g-4">
      <% products.forEach(product => { %>
        <% 
          const price = parseFloat(product.price);
          const hasDiscount = product.discount > 0;
          const discountedPrice = hasDiscount ? price - (price * product.discount / 100) : price;
        %>

        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
          <div class="card h-100 border-0 shadow-sm product-card transition">
            <div class="position-relative">
              <img 
                src="<%= product.image ? product.image : '/images/default-product.png' %>" 
                class="card-img-top p-3" 
                alt="<%= product.name %>"
              >
              <% if(hasDiscount){ %>
                <span class="badge bg-danger position-absolute top-0 start-0 m-2 px-3 py-2 shadow-sm">
                  -<%= product.discount %>%
                </span>
              <% } %>
            </div>

            <div class="card-body d-flex flex-column">
              <h6 class="fw-bold text-dark mb-1"><%= product.name %></h6>
              <p class="small text-muted mb-3">
                <%= (product.description || '').substring(0, 60) %>...
              </p>

              <div class="mt-auto d-flex justify-content-between align-items-center">
                <% if(hasDiscount){ %>
                  <div>
                    <span class="fw-bold text-primary">$<%= discountedPrice.toFixed(2) %></span>
                    <span class="text-muted text-decoration-line-through small">$<%= price.toFixed(2) %></span>
                  </div>
                <% } else { %>
                  <p class="fw-bold text-primary mb-0">$<%= price.toFixed(2) %></p>
                <% } %>

                <a href="/cart/add/<%= product.id %>" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                  <i class="bi bi-bag-plus me-1"></i> Add
                </a>
              </div>
            </div>
          </div>
        </div>

      <% }) %>
    </div>

    <!-- Pagination -->
    <nav class="mt-5">
      <ul class="pagination justify-content-center flex-wrap">
        <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
          <a class="page-link rounded-pill" href="?page=<%= currentPage - 1 %>">Previous</a>
        </li>
        <% for(let i = 1; i <= totalPages; i++) { %>
          <li class="page-item <%= currentPage === i ? 'active' : '' %>">
            <a class="page-link rounded-pill" href="?page=<%= i %>"><%= i %></a>
          </li>
        <% } %>
        <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
          <a class="page-link rounded-pill" href="?page=<%= currentPage + 1 %>">Next</a>
        </li>
      </ul>
    </nav>

  </div>
</section>

<!-- Bootstrap Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<!-- Custom Styles -->
<style>
  .product-card {
    transition: all 0.3s ease;
    border-radius: 1rem;
    overflow: hidden;
  }
  .product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 1rem 1.5rem rgba(0, 0, 0, 0.1);
  }
  .product-card img {
    height: 220px;
    object-fit: contain;
    background-color: #f8f9fa;
    border-bottom: 1px solid #e9ecef;
  }
  .pagination .page-link {
    border: none;
    color: #0d6efd;
    margin: 0 3px;
  }
  .pagination .active .page-link {
    background-color: #0d6efd;
    color: white;
  }
  .pagination .page-link:hover {
    background-color: #e9ecef;
  }
</style>
