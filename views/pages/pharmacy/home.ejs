<!-- Hero Section -->
<section class="bg-white text-center py-5">
  <div class="container py-4">
    <div class="row align-items-center">
      <div class="col-lg-6 mb-4 mb-lg-0 text-lg-start">
        <h1 class="display-5 fw-bold text-primary mb-3">
          Welcome to <%= pharmacy.pharmacy_name %>
        </h1>
        <p class="lead text-muted mb-4">
          Reliable medicines, health essentials, and expert advice — all in one trusted pharmacy.
        </p>
        <a href="/home/store" class="btn btn-primary btn-lg rounded-pill px-4 me-2">
          <i class="bi bi-capsule me-2"></i>Shop Medicines
        </a>
        <a href="/home/contact" class="btn btn-outline-primary btn-lg rounded-pill px-4">
          <i class="bi bi-chat-dots me-2"></i>Get Support with AI
        </a>
      </div>
      <div class="col-lg-6 text-center">
        <img src="<%= pharmacy.image %>" alt="Pharmacy" class="img-fluid" style="max-height: 300px;">
      </div>
    </div>
  </div>
</section>

<!-- Key Benefits Section -->
<section class="py-5 bg-light">
  <div class="container text-center">
    <h2 class="fw-bold text-primary mb-5">Why Choose Us?</h2>
    <div class="row g-4">
      <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body py-4">
            <i class="bi bi-truck fs-1 text-primary mb-3"></i>
            <h6 class="fw-bold">Fast Delivery</h6>
            <p class="text-muted small mb-0">Get your medicines delivered safely and quickly.</p>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body py-4">
            <i class="bi bi-shield-check fs-1 text-primary mb-3"></i>
            <h6 class="fw-bold">Trusted Products</h6>
            <p class="text-muted small mb-0">We source only from certified and verified suppliers.</p>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body py-4">
            <i class="bi bi-heart-pulse fs-1 text-primary mb-3"></i>
            <h6 class="fw-bold">Professional Care</h6>
            <p class="text-muted small mb-0">Our pharmacists are ready to help you anytime.</p>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body py-4">
            <i class="bi bi-percent fs-1 text-primary mb-3"></i>
            <h6 class="fw-bold">Exclusive Offers</h6>
            <p class="text-muted small mb-0">Enjoy regular discounts and loyalty rewards.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Featured Products Section -->
<section class="py-5">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="fw-bold text-primary mb-0">Popular Offers</h2>
      <a href="/medicines" class="text-decoration-none fw-semibold text-primary">
        View All <i class="bi bi-arrow-right-circle ms-1"></i>
      </a>
    </div>
    <div class="row g-4">


    <div class="row g-3">
  <% products.forEach(product => { %>
    <% 
      const price = parseFloat(product.price); // تحويل السعر مرة واحدة
      const hasOffer = product.offer > 0;
      const discountedPrice = hasOffer ? price - (price * product.offer / 100) : price;
    %>

    <div class="col-md-3 col-6">
      <div class="card border-0 shadow-sm h-100 position-relative">
        
        <!-- شارة الخصم -->
        <% if (hasOffer) { %>
          <span class="badge bg-danger position-absolute top-0 end-0 m-2 px-2 py-1">
            -<%= product.offer %>%
          </span>
        <% } %>

        <!-- صورة المنتج -->
        <img 
          src="<%= product.image ? product.image : 'https://cdn-icons-png.flaticon.com/512/3209/3209959.png' %>" 
          class="card-img-top p-3" 
          alt="<%= product.name %>"
          style="height: 180px; object-fit: contain;"
        >

        <!-- تفاصيل المنتج -->
        <div class="card-body text-center">
          <h6 class="fw-bold mb-1"><%= product.name %></h6>
          <p class="small text-muted mb-2">
            <%= product.category_name ? 'Category: ' + product.category_name : '' %>
          </p>

          <!-- السعر -->
          <% if (hasOffer) { %>
            <p class="mb-2">
              <span class="text-danger fw-bold">$<%= discountedPrice.toFixed(2) %></span>
              <span class="text-muted text-decoration-line-through small">$<%= price.toFixed(2) %></span>
            </p>
          <% } else { %>
            <p class="mb-2 fw-bold">$<%= price.toFixed(2) %></p>
          <% } %>

          <a href="/product/<%= product.id %>" class="btn btn-outline-primary btn-sm rounded-pill px-3">
            Details
          </a>
        </div>
      </div>
    </div>
  <% }); %>
</div>


</section>

<!-- Call to Action -->
<section class="py-5 text-center bg-primary text-white">
  <div class="container">
    <h3 class="fw-bold mb-3">Need personal advice?</h3>
    <p class="mb-4">Talk to our licensed pharmacists — we're here to help you choose the right treatment.</p>
    <a href="/home/contact" class="btn btn-light btn-lg rounded-pill px-4">
      <i class="bi bi-telephone me-2"></i>Contact a Pharmacist
    </a>
  </div>
</section>