<section class="py-5 bg-light">
  <div class="container">
    <!-- Section Title -->
    <div class="text-center mb-5">
      <h2 class="fw-bold text-success mb-2">💚 Special Offers</h2>
      <p class="text-muted">Save big on your favorite health and wellness products!</p>
    </div>

    <!-- Offers Grid -->
    <div class="row g-4">

    <section class="py-5 bg-light">
  <div class="container">
    <h2 class="fw-bold text-primary mb-4">Special Offers</h2>
    <div class="row g-4">
      <% if (products && products.length > 0) { %>
        <% products.forEach(product => { %>
          <% 
            const price = parseFloat(product.price);
            const discount = product.offer || 0;
            const discountedPrice = price - (price * discount / 100);
          %>
          <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm border-0 offer-card d-flex flex-column">
              <div class="position-relative">
                <img src="<%= product.image ? product.image : 'https://via.placeholder.com/300x200' %>" 
                     class="card-img-top img-fluid" alt="<%= product.name %>">
                <% if(discount > 0){ %>
                  <span class="badge bg-success position-absolute top-0 start-0 m-2 px-3 py-2 rounded-pill fw-semibold">
                    -<%= discount %>%
                  </span>
                <% } %>
              </div>
              <div class="card-body d-flex flex-column flex-grow-1">
                <h5 class="card-title fw-semibold mb-2"><%= product.name %></h5>
                <p class="card-text text-muted small mb-3 flex-grow-1">
                  <%= (product.description || '').substring(0, 80) %>...
                </p>
                <div>
                  <% if(discount > 0){ %>
                    <p class="mb-1 text-decoration-line-through text-muted small">$<%= price.toFixed(2) %></p>
                    <p class="fw-bold text-success mb-3 fs-5">$<%= discountedPrice.toFixed(2) %></p>
                  <% } else { %>
                    <p class="fw-bold text-primary mb-3 fs-5">$<%= price.toFixed(2) %></p>
                  <% } %>
                  <a href="/cart/add/<%= product.id %>" class="btn btn-outline-success rounded-pill w-100">
                    Add to Cart
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="text-muted">No offers available at the moment.</p>
      <% } %>
    </div>
  </div>
</section>
 

    </div>
  </div>
</section>

<!-- Custom Styles -->
<style>
  .offer-card {
    border-radius: 1rem;
    transition: all 0.3s ease;
    background-color: #fff;
  }

  .offer-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 1rem 1.5rem rgba(0, 0, 0, 0.1);
  }

  .offer-card img {
    height: 200px;
    object-fit: cover;
    border-top-left-radius: 1rem;
    border-top-right-radius: 1rem;
  }

  .badge {
    font-size: 0.85rem;
  }

  .card-body {
    display: flex;
    flex-direction: column;
  }
</style>