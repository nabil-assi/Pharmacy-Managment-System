<body>
  <div class=" text-center">
    <div class="pharma-header">
      <i class="bi bi-capsule"></i>
      <h2>Forgot Password</h2>
      <p class="text-muted fs-6">Enter your registered email to receive a reset link</p>
    </div>

    <form action="/login/forgot-password" method="post" class="text-start">
      <div class="mb-3">
        <label for="email" class="form-label fw-semibold text-success">
          <i class="bi bi-envelope-at me-1"></i>Email Address
        </label>
        <input 
          type="email" 
          class="form-control" 
          id="email" 
          name="email" 
          placeholder="example@pharmacy.com" 
          required>
      </div>

      <button type="submit" class="btn btn-pharma w-100 py-2 fw-semibold d-flex align-items-center justify-content-center mt-3">
        <i class="bi bi-send-fill me-2"></i> Send Reset Link
      </button>

      <div class="text-center mt-4">
        <a href="/login" class="small text-success fw-medium text-decoration-none">
          <i class="bi bi-arrow-left-circle me-1"></i> Back to Login
        </a>
      </div>
    </form>

    <div class="footer-text mt-4">
      <i class="bi bi-heart-pulse-fill text-success"></i> We care about your health
    </div>
  </div>
</body>
