<div class="login-card text-center">
  <h3 class="mb-4 fw-bold text-primary"><i class="bi bi-capsule me-2"></i>Login</h3>

  <form method="POST" action="/login/check-login">
    <div class="mb-3 text-start">
      <label for="email" class="form-label">Email</label>
      <input type="text" class="form-control" id="email" name="email" placeholder="Enter your email" required>
    </div>

    <div class="mb-3 text-start">
      <label for="password" class="form-label">Password</label>
      <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required>
    </div>

    <div class="mb-3 d-flex justify-content-center gap-2">
      <button type="submit" name="role" value="Admin" class="btn btn-outline-primary">Admin</button>
      <button type="submit" name="role" value="Pharmacist" class="btn btn-outline-primary">Pharmacist</button>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
      <a href="/login/forgot-password" class="small text-primary">Forgot password?</a>
    </div>

    <p class="mt-3 text-muted small">Choose your role to login</p>
  </form>
</div>