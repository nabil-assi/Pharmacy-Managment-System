<div class="main-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold text-dark">Offers List</h4>
        <button class="btn btn-pharma d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#addOfferModal">
            <i class="bi bi-plus-circle me-1"></i> Add Offer
        </button>
    </div>

    <div class="table-responsive shadow-sm rounded bg-white p-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-info text-dark">
                <tr>
                    <th>#</th>
                    <th>Product</th>
                    <th>Original Price</th>
                    <th>Discount</th>
                    <th>Discounted Price</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (offers && offers.length> 0) { %>
                    <% for (let i=0; i < offers.length; i++) { const offer=offers[i]; const price=offer.price !=null ?
                        Number(offer.price).toFixed(2) : '0.00' ; const offerPercent=offer.offer !=null ?
                        Number(offer.offer) : 0; const discountedPrice=offer.price !=null ? (Number(offer.price) * (1 -
                        offerPercent/100)).toFixed(2) : '0.00' ; const expiryDate=offer.expiry_date ? new
                        Date(offer.expiry_date).toISOString().split('T')[0] : '' ; %>
                        <tr>
                            <td>
                                <%= i + 1 %>
                            </td>
                            <td>
                                <%= offer.name || 'N/A' %>
                            </td>
                            <td>$<%= price %>
                            </td>
                            <td>
                                <%= offerPercent %>%
                            </td>
                            <td>$<%= discountedPrice %>
                            </td>

                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" data-bs-toggle="modal"
                                    data-bs-target="#editOfferModal<%= offer.id %>">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal"
                                    data-bs-target="#deleteOfferModal<%= offer.id %>">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>

                        <!-- Edit Offer Modal -->
                        <div class="modal fade" id="editOfferModal<%= offer.id %>" tabindex="-1"
                            aria-labelledby="editOfferLabel<%= offer.id %>" aria-hidden="true">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <form action="/dashboard/offers/update" method="POST">
                                        <input type="hidden" name="id" value="<%= offer.id %>">
                                        <div class="modal-header bg-primary text-white">
                                            <h5 class="modal-title" id="editOfferLabel<%= offer.id %>">Edit Offer: <%=
                                                    offer.name || '' %>
                                            </h5>
                                            <button type="button" class="btn-close btn-close-white"
                                                data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="row g-3">
                                                 
                                                <div class="col-md-6">
                                                    <label class="form-label">Offer (%)</label>
                                                    <input type="number" step="0.01" name="offer" class="form-control"
                                                        value="<%= offerPercent %>" required>
                                                </div>

                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary"
                                                data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-pharma">Save Changes</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Delete Offer Modal -->
                        <div class="modal fade" id="deleteOfferModal<%= offer.id %>" tabindex="-1"
                            aria-labelledby="deleteOfferLabel<%= offer.id %>" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <form action="/dashboard/offers/delete/<%= offer.id %>" method="POST">
                                        <div class="modal-header bg-danger text-white">
                                            <h5 class="modal-title" id="deleteOfferLabel<%= offer.id %>">Confirm
                                                Deletion</h5>
                                            <button type="button" class="btn-close btn-close-white"
                                                data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <p>Are you sure you want to delete the offer for <strong>
                                                    <%= offer.name || '' %>
                                                </strong>?</p>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary"
                                                data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-danger">Delete</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <% } %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="text-center">No offers available</td>
                                </tr>
                                <% } %>

            </tbody>
        </table>
    </div>
</div>

<!-- Add Offer Modal -->
<div class="modal fade" id="addOfferModal" tabindex="-1" aria-labelledby="addOfferLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form action="/dashboard/offers/add" method="POST">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="addOfferLabel">Add New Offer</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Product Name</label>
                            <input type="text" name="product_name" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Original Price</label>
                            <input type="number" step="0.01" name="original_price" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Discount (%)</label>
                            <input type="number" step="0.01" name="discount" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Valid Until</label>
                            <input type="date" name="valid_until" class="form-control" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-pharma">Add Offer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .table-responsive {
        background: #fff;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
    }

    .table-hover tbody tr:hover {
        background-color: #f1fdf4;
        transition: 0.2s;
    }

    .table-info {
        background: linear-gradient(90deg, #dbeafe, #bfdbfe);
    }

    .btn-pharma {
        background: linear-gradient(135deg, #16a34a, #22c55e);
        color: #fff;
        font-weight: 600;
        border: none;
        transition: 0.3s;
    }

    .btn-pharma:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(34, 197, 94, 0.4);
    }

    .modal-header.bg-primary {
        background: linear-gradient(135deg, #3b82f6, #06b6d4);
    }

    .modal-header.bg-danger {
        background: linear-gradient(135deg, #dc2626, #f87171);
    }
</style>