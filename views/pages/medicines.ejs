<!-- Main Content -->
<div class="main-content">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4>Medicine Inventory</h4>
    <button class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Add Medicine</button>
  </div>

  <div class="table-responsive">
    <table class="table table-bordered table-striped">
      <thead class="table-light">

        <tr>
          <th>#</th>
          <th>Name</th>
          <th>Price</th>
          <th>Quantity</th>
          <th>Expiry Date</th>
          <th>Category</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% for( let i=0; i < medicines.length; i++ ) { %>

           <tr>
            <td><%= i+1 %></td>
            <td><%= medicines[i].name %></td>
            <td>$<%= parseFloat(medicines[i].price).toFixed(2) %></td>
            <td><%= medicines[i].quantity %></td>
            <td><%= medicines[i].expiry_date_formatted %></td>
            <td><%= medicines[i].category_name %></td>
            <td>
              <button class="btn btn-sm btn-outline-primary me-1" onclick="editMedicine(<%= medicines[i].id %>)">
                <i class="bi bi-pencil-square"></i>
              </button>
              <button class="btn btn-sm btn-outline-danger" onclick="deleteMedicine(<%= medicines[i].id %>)">
                <i class="bi bi-trash"></i>
              </button>
            </td>
          </tr>

          <% } %>

      </tbody>
    </table>
  </div>

</div>