<div class="main-content">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold text-dark">Products Inventory</h4>
    <button class="btn btn-pharma d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#addMedicineModal">
      <i class="bi bi-plus-circle me-1"></i> Add Product
    </button>
  </div>

  <div class="table-responsive shadow-sm rounded bg-white p-3">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-success text-dark">
        <tr>
          <th>#</th>
          <th>Name</th>
          <th>Price</th>
          <th>Quantity</th>
          <th>Expiry Date</th>
          <th>Category</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% for(let i=0;i<medicines.length;i++){ %>
        <tr>
          <td><%= i+1 %></td>
          <td><%= medicines[i].name %></td>
          <td>$<%= parseFloat(medicines[i].price).toFixed(2) %></td>
          <td><%= medicines[i].quantity %></td>
          <td><%= medicines[i].expiry_date_formatted %></td>
          <td><%= medicines[i].category_name %></td>
          <td>
            <button class="btn btn-sm btn-outline-success me-1" data-bs-toggle="modal"
              data-bs-target="#editMedicineModal<%= medicines[i].id %>">
              <i class="bi bi-pencil-square"></i>
            </button>
            <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal"
              data-bs-target="#deleteModal<%= medicines[i].id %>">
              <i class="bi bi-trash"></i>
            </button>
          </td>
        </tr>

        <!-- Edit Modal -->
<div class="modal fade" id="editMedicineModal<%= medicines[i].id %>" tabindex="-1"
  aria-labelledby="editMedicineLabel<%= medicines[i].id %>" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
       <form action="/dashboard/products/update" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="id" value="<%= medicines[i].id %>">
        <div class="modal-header bg-success text-white">
          <h5 class="modal-title" id="editMedicineLabel<%= medicines[i].id %>">
            Update Medicine: <%= medicines[i].name %>
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
            aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Name</label>
              <input type="text" name="name" class="form-control" value="<%= medicines[i].name %>" required>
            </div>
            <div class="col-md-4">
              <label class="form-label">Price</label>
              <input type="number" name="price" class="form-control" step="0.01"
                value="<%= parseFloat(medicines[i].price).toFixed(2) %>" required>
            </div>
            <div class="col-md-4">
              <label class="form-label">Quantity</label>
              <input type="number" name="quantity" class="form-control" value="<%= medicines[i].quantity %>" required>
            </div>
            <div class="col-md-4">
              <label class="form-label">Expiry Date</label>
              <input type="date" name="expiry_date" class="form-control"
                value="<%= new Date(medicines[i].expiry_date).toISOString().split('T')[0] %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Category</label>
              <select name="category_id" class="form-select" required>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.id %>" <%= cat.id === medicines[i].category_id ? 'selected' : '' %>>
                    <%= cat.name %>
                  </option>
                <% }) %>
              </select>
            </div>

             <div class="col-md-6">
              <label class="form-label">Update Image (optional)</label>
              <input type="file" name="image" accept="image/*" class="form-control">
            </div>

             <div class="col-md-6">
              <label class="form-label d-block">Current Image</label>
              <img src="<%= medicines[i].image %>" alt="Current Image"
                style="width: 120px; border-radius: 5px; border: 1px solid #ccc;">
            </div>

          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

        <!-- Delete Modal -->
        <div class="modal fade" id="deleteModal<%= medicines[i].id %>" tabindex="-1"
          aria-labelledby="deleteLabel<%= medicines[i].id %>" aria-hidden="true">
          <div class="modal-dialog">
            <div class="modal-content">
              <form action="/dashboard/products/delete/<%= medicines[i].id %>" method="POST">
                <div class="modal-header bg-danger text-white">
                  <h5 class="modal-title" id="deleteLabel<%= medicines[i].id %>">Confirm Deleting</h5>
                  <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                    aria-label="Close"></button>
                </div>
                <div class="modal-body">
                  <p>Are you sure you want to delete <strong><%= medicines[i].name %></strong>?</p>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                  <button type="submit" class="btn btn-danger">Delete</button>
                </div>
              </form>
            </div>
          </div>
        </div>
        <% } %>
      </tbody>
    </table>
  </div>

 <!-- Add Medicine Modal -->
<div class="modal fade" id="addMedicineModal" tabindex="-1" aria-labelledby="addMedicineLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form action="/dashboard/products/add" method="POST" enctype="multipart/form-data">
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title" id="addMedicineLabel">Add New Product</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Name</label>
              <input type="text" name="name" class="form-control" required>
            </div>
            <div class="col-md-4">
              <label class="form-label">Price</label>
              <input type="number" name="price" class="form-control" step="0.01" required>
            </div>
            <div class="col-md-4">
              <label class="form-label">Quantity</label>
              <input type="number" name="quantity" class="form-control" required>
            </div>
            <div class="col-md-4">
              <label class="form-label">Expiry Date</label>
              <input type="date" name="expiry_date" class="form-control" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Category</label>
              <select name="category_id" class="form-select" required>
                <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>"><%= cat.name %></option>
                <% }) %>
              </select>
            </div>

            <!-- ✅ حقل رفع الصورة -->
            <div class="col-md-6">
              <label class="form-label">Medicine Image</label>
              <input type="file" name="image" accept="image/*" class="form-control" required>
            </div>

          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Add Medicine</button>
        </div>
      </form>
    </div>
  </div>
</div>


</div>

<style>
  /* Table container */
  .table-responsive {
    background: #fff;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
  }

  .table-hover tbody tr:hover {
    background-color: #e6f4ea;
    transition: 0.2s;
  }

  .table-success {
    background: linear-gradient(90deg, #d1fae5, #a7f3d0);
  }

  /* Buttons */
  .btn-pharma {
    background: linear-gradient(135deg, #16a34a, #22c55e);
    color: #fff;
    font-weight: 600;
    border: none;
    transition: 0.3s;
  }

  .btn-pharma:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(34, 197, 94, 0.4);
  }

  /* Modals */
  .modal-header.bg-success {
    background: linear-gradient(135deg, #16a34a, #22c55e);
  }

  .modal-header.bg-primary {
    background: linear-gradient(135deg, #3b82f6, #06b6d4);
  }
</style>
