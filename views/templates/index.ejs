<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>
        <%= title %>
    </title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet"> -->
    <link rel="stylesheet" href="../../bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="../../bootstrap-icons/font/bootstrap-icons.css">
    <script src="../../bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        body {
            background-color: #f1f3f5;
        }

        .sidebar {
            height: 100vh;
            background-color: #1f2d3d;
            color: #fff;
        }

        .sidebar .nav-link {
            color: #adb5bd;
            padding: 12px 20px;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background-color: #2c3e50;
            color: #fff;
        }

        .navbar {
            background-color: #ffffff;
            border-bottom: 1px solid #dee2e6;
        }

        .main-content {
            padding: 30px;
        }

        .card {
            border: none;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
        }
    </style>
</head>

<body>
    <div class="d-flex">

        <%- include('../partials/sidebar') %>

            <%- include('../partials/header') %>
                <div class="flex-grow-1">

                    <%- include('../partials/navbar') %>
                        <% if (typeof message !=='undefined' && message) { %>
                            <div class="container position-fixed top-0 start-50 translate-middle-x mt-3"
                                style="z-index: 1055; max-width: 600px;">
                                <div class="alert alert-<%= message.type %> d-flex align-items-center shadow-sm border-0 alert-dismissible fade show"
                                    role="alert">
                                    <i
                                        class="bi <%= message.type === 'success' ? 'bi-check-circle-fill' : message.type === 'danger' ? 'bi-x-circle-fill' : 'bi-info-circle-fill' %> me-2 fs-5"></i>
                                    <div>
                                        <%= message.text %>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"
                                        aria-label="Close"></button>
                                </div>
                            </div>
                            <% } %>
                                <%- body %>
                                    <%- include('../partials/footer') %>
                </div>
    </div>


</body>
<script>
    setTimeout(() => {
        const alert = document.querySelector('.alert');
        if (alert) alert.classList.remove('show');
    }, 4000);  
</script>

</html>